# Build artifacts (will be generated on Vercel)
# Note: dist/ is NOT ignored - it's needed for serverless functions
# Note: src/ is needed during build for tsc compilation, but api/index.ts imports from dist/
# Note: Prisma generated files (src/generated/prisma) are needed at runtime
# Note: node_modules/.prisma is needed for Prisma query engine binaries
# CRITICAL: Exclude src/*.ts from being detected as serverless functions
# Only api/ folder should contain serverless functions
# NOTE: We need src/*.ts for the build process, but Vercel won't treat them as serverless functions
# because they're not in the api/ folder. So we don't exclude them here.
# src/*.ts
!src/generated/**/*
*.tsbuildinfo
# CRITICAL: Explicitly include dist/ folder (even though it's in .gitignore)
# Vercel needs dist/ for serverless functions to work
!dist/
!dist/**/*

# Misc
.DS_Store
Thumbs.db
*.pem
*.key
*.cert
